{
    "name": "bnmetrics/laravel-shopify-api",
    "description": "Shopify API wrapper for laravel",
    "keywords": [
        "palPalani",
        "shopify", 
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
          "name": "Luna Chen",
          "email": "luna@bonnenuitmetrics.com"
        },
        {
            "name": "palPalani",
            "email": "palani.p@gmail.com",
            "role": "Developer"
        }
    ],

    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/socialite" : "^4.0|^5.0"
    },
    
    "require-dev": {
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.5",
        "phpunit/phpunit": "^9.5"
    },
    "scripts": {
        "format": "vendor/bin/pint"
    },
    "autoload": {
        "psr-4": {
          "BNMetrics\\Shopify\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
     "extra": {
         "laravel": {
             "providers": [
                 "BNMetrics\\Shopify\\ShopifyServiceProvider"
             ],
             "aliases": {
                 "Shopify": "BNMetrics\\Shopify\\Facade\\ShopifyFacade"
             }
         }
     },
     "minimum-stability": "dev",
     "prefer-stable": true
}
