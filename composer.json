{
    "name": "bnmetrics/laravel-shopify-api",
    "description": "Shopify API wrapper for laravel",
    "keywords": [
        "palPalani",
        "shopify", 
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
          "name": "Luna Chen",
          "email": "luna@bonnenuitmetrics.com"
        },
        {
            "name": "palPalani",
            "email": "palani.p@gmail.com",
            "role": "Developer"
        }
    ],

    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/socialite" : "^4.0|^5.0"
    },
    
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^6.0|^7.0|^8.0",
        "larastan/larastan": "^2.0.1",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "autoload": {
        "psr-4": {
          "BNMetrics\\Shopify\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
     "extra": {
         "laravel": {
             "providers": [
                 "BNMetrics\\Shopify\\ShopifyServiceProvider"
             ],
             "aliases": {
                 "Shopify": "BNMetrics\\Shopify\\Facade\\ShopifyFacade"
             }
         }
     },
     "minimum-stability": "dev",
     "prefer-stable": true
}
